# Copy to .env and adjust values before running docker compose

# ── Endpoint ──────────────────────────────────────────────────
ENDPOINT_URL=https://api.example.com/ingest
ENDPOINT_FEED=my-feed
ENDPOINT_ENVIRONMENT=dev

# ── Output SSL ─────────────────────────────────────────────────
OUTPUT_SSL_ENABLED=false
OUTPUT_KEYSTORE_PASSWORD=changeit
OUTPUT_TRUSTSTORE_PASSWORD=changeit

# ── Input SSL ──────────────────────────────────────────────────
INPUT_SSL_ENABLED=false
INPUT_KEYSTORE_PASSWORD=changeit
INPUT_TRUSTSTORE_PASSWORD=changeit

# ── Kafka (profile: kafka) ─────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=forwarder-input
KAFKA_GROUP_ID=generic-forwarder

# ── RabbitMQ (profile: rabbitmq) ───────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=forwarder-input
RABBITMQ_VHOST=/

# ── SMB (profile: smb) ─────────────────────────────────────────
SMB_HOST=smb-server
SMB_SHARE=myshare
SMB_DIRECTORY=/incoming
SMB_USERNAME=smbuser
SMB_PASSWORD=smbpass
SMB_DOMAIN=WORKGROUP
SMB_FILE_PATTERN=*.*
SMB_POLL_DELAY=5000
SMB_DELETE_AFTER_READ=false

# ── File (profile: file) ───────────────────────────────────────
FILE_POLL_DELAY=5000
