<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot 3.5.3  — requires Java 17+
        Apache Camel 4.18.0 — matches versions available in the offline repository
        JCIFS-NG 2.1.3      — SMB2/SMB3 + NTLMv2
        NOTE: No BOM imports in <dependencyManagement> because the offline
        environment only mirrors specific JARs, not the camel-bom/camel-spring-boot-bom
        POM artifacts.  Every version is therefore declared explicitly.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>smb-csv-processor</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>SMB CSV Processor</name>
    <description>
        Downloads large zipped CSVs from an SMB share, extracts them, processes
        each row through a YAML-driven mapping / validation pipeline, writes valid
        rows to a success file (then SFTPs to a remote server) and quarantines
        invalid rows with an error-reason column.
    </description>

    <properties>
        <!-- Spring Boot 3.x minimum is Java 17 -->
        <java.version>17</java.version>
        <camel.version>4.18.0</camel.version>
        <jcifs-ng.version>2.1.3</jcifs-ng.version>
        <commons-compress.version>1.21</commons-compress.version>
        <commons-csv.version>1.9.0</commons-csv.version>
    </properties>

    <!--
        No <dependencyManagement> BOM imports.
        The offline repository does not carry camel-bom or camel-spring-boot-bom
        POM artifacts, so Maven would fail with "could not find artifact …:…:pom".
        All versions are pinned explicitly in <dependencies> instead.
    -->

    <dependencies>
        <!-- ============================================================
             Spring Boot core
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <version>3.5.3</version>
        </dependency>

        <!-- Spring Integration: @EnableIntegration, channels -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-integration</artifactId>
            <version>3.5.3</version>
        </dependency>

        <!-- IDE metadata for @ConfigurationProperties -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <version>3.5.3</version>
            <optional>true</optional>
        </dependency>

        <!-- ============================================================
             Apache Camel 4.x — file routing, SFTP upload
             Camel 4.x requires Spring Boot 3.x (Jakarta EE 9+).
             Versions are explicit — no BOM available offline.
             ============================================================ -->
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-spring-boot-starter</artifactId>
            <version>${camel.version}</version>
        </dependency>

        <!-- camel-ftp: FTP (commons-net) + SFTP (Apache MINA SSHD).
             NOTE: Camel 4.x replaced JSch with MINA SSHD — do NOT add
             com.jcraft:jsch; it is no longer used for SFTP. -->
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-ftp-starter</artifactId>
            <version>${camel.version}</version>
        </dependency>

        <!-- ============================================================
             SMB connectivity — jcifs-ng (SMB2 / SMB3 / NTLMv2)
             ============================================================ -->
        <dependency>
            <groupId>eu.agno3.jcifs</groupId>
            <artifactId>jcifs-ng</artifactId>
            <version>${jcifs-ng.version}</version>
        </dependency>

        <!-- ============================================================
             CSV parsing — Apache Commons CSV (streaming, no full-load)
             ============================================================ -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>

        <!-- ============================================================
             ZIP streaming — Apache Commons Compress
             ============================================================ -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>${commons-compress.version}</version>
        </dependency>

        <!-- ============================================================
             YAML — SnakeYAML
             Spring Boot 3.5.3 manages snakeyaml; declared here so the
             version is visible in dependency reports.
             ============================================================ -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <!-- version managed by spring-boot-starter-parent 3.5.3 -->
        </dependency>

        <!-- ============================================================
             Test
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>3.5.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-test-spring-junit5</artifactId>
            <version>${camel.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Fat-jar for deployment to isolated environments -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
