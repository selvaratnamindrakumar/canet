<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.company</groupId>
    <artifactId>cloud-readiness-demo</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>cloud-readiness-demo</name>
    <description>Spring Boot Cloud Readiness PoC — Docker &amp; AWS migration demo</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Jib version — centralised for easy upgrades -->
        <jib.version>3.4.3</jib.version>
        <!-- GraalVM Native Tools version — must match Spring Boot BOM expectations -->
        <native.maven.plugin.version>0.10.3</native.maven.plugin.version>
        <!-- Default Jib target — overridden on command line for ECR push -->
        <jib.to.image>cloud-readiness-demo</jib.to.image>
        <jib.from.image>eclipse-temurin:17-jre-alpine</jib.from.image>
        <!-- Set true on Windows/enterprise networks with SSL inspection (PKIX errors).
             Always false in CI/CD pipelines and AWS environments. -->
        <jib.allowInsecureRegistries>false</jib.allowInsecureRegistries>
    </properties>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator — health, info, metrics endpoints -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Bean validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Prometheus metrics (for CloudWatch / Grafana scraping) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Lombok — boilerplate reduction -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- ── Spring Boot Maven Plugin ──────────────────────────────
                 Creates executable fat JAR with layered JAR support for
                 optimal Docker / Jib layer caching.
                 ─────────────────────────────────────────────────────── -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <!-- Layered JAR — critical for Jib and Docker layer caching -->
                    <layers>
                        <enabled>true</enabled>
                    </layers>
                </configuration>
            </plugin>

            <!-- ── Jib Maven Plugin ───────────────────────────────────────
                 Builds and pushes OCI-compliant container images WITHOUT
                 requiring a local Docker daemon — ideal for enterprise
                 Windows workstations and CI environments.

                 Commands:
                   mvn jib:buildTar            → tar file in target/
                   mvn jib:build               → push directly to registry
                   mvn jib:dockerBuild         → load into local Docker (if available)

                 ECR push example (no Docker needed):
                   mvn jib:build \
                     -Djib.to.image=<account>.dkr.ecr.<region>.amazonaws.com/cloud-readiness-demo \
                     -Djib.to.auth.username=AWS \
                     -Djib.to.auth.password=$(aws ecr get-login-password)

                 Tar build (for transfer to Docker-enabled environment):
                   mvn jib:buildTar
                   aws s3 cp target/jib-image.tar s3://my-bucket/images/
                 ─────────────────────────────────────────────────────── -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>${jib.version}</version>
                <configuration>
                    <!-- Enterprise environments with SSL inspection / untrusted CA certs
                         set allowInsecureRegistries=true to bypass PKIX errors when pulling
                         the base image from Docker Hub.  Override on the command line:
                           mvn jib:buildTar -Djib.allowInsecureRegistries=false  (default in CI) -->
                    <allowInsecureRegistries>${jib.allowInsecureRegistries}</allowInsecureRegistries>
                    <from>
                        <!-- Base image — JRE only, no build tools in the final image -->
                        <image>${jib.from.image}</image>
                        <platforms>
                            <!-- Build for linux/amd64 (ECS Fargate default) -->
                            <platform>
                                <os>linux</os>
                                <architecture>amd64</architecture>
                            </platform>
                        </platforms>
                    </from>
                    <to>
                        <!-- Override with -Djib.to.image=<ecr-url>/cloud-readiness-demo -->
                        <image>${jib.to.image}</image>
                        <tags>
                            <tag>${project.version}</tag>
                            <tag>latest</tag>
                        </tags>
                    </to>
                    <container>
                        <mainClass>com.company.demo.CloudReadinessApplication</mainClass>
                        <ports>
                            <port>8080</port>
                        </ports>
                        <environment>
                            <SPRING_PROFILES_ACTIVE>prod</SPRING_PROFILES_ACTIVE>
                            <SERVER_PORT>8080</SERVER_PORT>
                            <APP_ENVIRONMENT>production</APP_ENVIRONMENT>
                            <APP_VERSION>${project.version}</APP_VERSION>
                        </environment>
                        <jvmFlags>
                            <!-- Container-aware memory limits — respects cgroup limits set by ECS -->
                            <jvmFlag>-XX:+UseContainerSupport</jvmFlag>
                            <jvmFlag>-XX:MaxRAMPercentage=75.0</jvmFlag>
                            <jvmFlag>-Djava.security.egd=file:/dev/./urandom</jvmFlag>
                        </jvmFlags>
                        <!-- Reproducible build timestamp -->
                        <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                        <!-- Run as non-root UID 1000 (security best practice) -->
                        <user>1000:1000</user>
                    </container>
                    <!-- Allow Jib to use the layered JAR from Spring Boot plugin -->
                    <containerizingMode>packaged</containerizingMode>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- ── Profiles ──────────────────────────────────────────────────────────
         native  : GraalVM Native Image compilation (requires GraalVM JDK)
                   mvn -Pnative native:compile
                   mvn -Pnative spring-boot:build-image  (requires Docker)
         ────────────────────────────────────────────────────────────────── -->
    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <!-- GraalVM Native Maven Plugin ─────────────────────────
                         Compiles the application to a native executable.
                         Requires: JAVA_HOME or GRAALVM_HOME → GraalVM JDK 17+

                         On EC2 Amazon Linux 2023:
                           sudo yum install -y java-17-amazon-corretto-devel
                           # or install GraalVM CE:
                           # https://github.com/graalvm/graalvm-ce-builds/releases

                         Compile command:
                           mvn -Pnative native:compile

                         Build OCI image (requires Docker):
                           mvn -Pnative spring-boot:build-image
                         ──────────────────────────────────────────────── -->
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native.maven.plugin.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                            <execution>
                                <id>test-native</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <phase>test</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>${project.artifactId}</imageName>
                            <buildArgs>
                                <!-- Fail fast — no JVM fallback in the native image -->
                                <buildArg>--no-fallback</buildArg>
                                <!-- Helpful diagnostics during PoC phase -->
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <!-- Enable HTTP/HTTPS support -->
                                <buildArg>--enable-url-protocols=http,https</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>

                    <!-- Spring Boot Plugin — AOT processing for native image -->
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <image>
                                <!-- Tag native images differently for comparison -->
                                <name>${project.artifactId}:${project.version}-native</name>
                                <env>
                                    <!-- Activate GraalVM native image in Paketo buildpack -->
                                    <BP_NATIVE_IMAGE>true</BP_NATIVE_IMAGE>
                                    <BP_JVM_VERSION>17</BP_JVM_VERSION>
                                </env>
                            </image>
                            <excludes>
                                <exclude>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </exclude>
                            </excludes>
                            <layers>
                                <enabled>true</enabled>
                            </layers>
                        </configuration>
                        <executions>
                            <!-- AOT processing — generates reflection/proxy hints for GraalVM -->
                            <execution>
                                <id>process-aot</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
