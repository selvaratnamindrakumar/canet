# =============================================================================
# Dockerfile.java8
# Multi-stage build for a Java 8 application (fat JAR / Spring Boot)
# Base: eclipse-temurin:8-jre-focal (Ubuntu 20.04 — glibc, broadest compat)
# =============================================================================

# Stage 1: Build
FROM eclipse-temurin:8-jdk-focal AS build

WORKDIR /workspace

# Copy dependency descriptors first (better layer caching)
COPY pom.xml .
# For Maven wrapper projects; remove if using system Maven
# COPY .mvn .mvn
# COPY mvnw .

# Download dependencies (cached layer if pom.xml unchanged)
RUN apt-get update -qq && apt-get install -y --no-install-recommends maven \
    && rm -rf /var/lib/apt/lists/*

RUN mvn dependency:go-offline -B

# Copy source and build
COPY src ./src
RUN mvn package -DskipTests -B

# Stage 2: Runtime
FROM eclipse-temurin:8-jre-focal AS runtime

# Security: create non-root user
RUN groupadd -r appgroup --gid=1001 \
 && useradd -r -g appgroup --uid=1001 --home-dir=/app --shell=/bin/false appuser

WORKDIR /app

# Copy only the fat JAR from the build stage
COPY --from=build /workspace/target/*.jar app.jar

# Non-root ownership
RUN chown -R appuser:appgroup /app

# Health check (requires the app to expose an HTTP endpoint)
# Adjust port and path to match your application
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/actuator/health || exit 1

USER appuser

EXPOSE 8080

# Container-aware JVM flags:
# - UseContainerSupport: respect cgroup CPU/memory limits (JDK 8u191+)
# - MaxRAMPercentage: use up to 75% of container memory for heap
# - InitialRAMPercentage: start heap at 50% of container memory
# - security.egd: faster SecureRandom seeding in containers
ENTRYPOINT ["java", \
  "-XX:+UseContainerSupport", \
  "-XX:MaxRAMPercentage=75.0", \
  "-XX:InitialRAMPercentage=50.0", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-jar", "app.jar"]
